# ==============================================================================
# TEKMAAN STUDIO — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public studio contact and meta configuration
NEXT_PUBLIC_STUDIO_EMAIL="tekmaan.connect@gmail.com"

# Direct WhatsApp chat number in international format (e.g. 919063127547).
NEXT_PUBLIC_WHATSAPP_NUMBER="+919063127547"

# Calendly booking link (e.g. https://calendly.com/tekmaan/discovery).
# Leave blank to automatically hide Calendly CTA buttons.
NEXT_PUBLIC_CALENDLY_URL=""

# Production site URL (used for canonical URLs and OpenGraph tags)
NEXT_PUBLIC_SITE_URL="https://tekmaan.com"

# ==============================================================================
# SERVER-SIDE EMAIL TRANSPORT (RESEND OR SMTP)
# ==============================================================================
# Option 1: Resend (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TEKMAAN Inquiries <onboarding@resend.dev>"

# Option 2: SMTP (e.g. Gmail with Google App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tekmaan.connect@gmail.com"
SMTP_PASS=""

# Inbox where new client inquiries should arrive
STUDIO_INBOX_EMAIL="tekmaan.connect@gmail.com"
